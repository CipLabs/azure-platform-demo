# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Ignore local variable values and saved plans (but keep example files).
*.tfvars
*.tfvars.json
!*.tfvars.example
*.tfplan
*.plan
tfplan

# Ignore backend configuration files (but keep example files).
*.conf
!*.conf.example

# Local environment files may contain credentials.
.env
.env.*
!.env.example

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout

# Documentation (not part of infrastructure codebase)
README.md
QUICKSTART.md

# Interview and planning documentation (local only)
DEPLOYMENT.md
HLD-PRODUCTION-HARDENING.md
INTERVIEW-INDEX.md
INTERVIEW-NARRATIVE.md
INTERVIEW-QUICK-REF.md
INTERVIEW-READY.md
FQDN-FIX.md
STATUS.md

# Snyk documentation (guides for setup, can be regenerated)
docs/SNYK_README.md
docs/SNYK_CHECKLIST.md
docs/SNYK_SETUP.md
docs/SNYK_SETUP_WALKTHROUGH.md
